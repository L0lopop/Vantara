 export class AboutNewTabChild extends RemotePageChild {
+  /**
+   * Vantara's page cannot read browser state itself. Before its scripts run,
+   * and whenever it is shown again (new tabs are preloaded in the
+   * background), its root element gets:
+   *   vn-locale  - UI locale
+   *   vn-blocked - the shield's all-time total
+   *   vn-palette - colour palette
+   *   vn-mode    - system, light or dark
+   *   vn-search  - JSON {name, url} of the default engine, {q} for the terms
+   * Requests from the page arrive as untrusted events with JSON details.
+   *
+   * @param {Event} event
+   */
+  #handleVantaraEvent(event) {
+    let root = this.document.documentElement;
+    switch (event.type) {
+      case "DOMDocElementInserted":
+        root.setAttribute("vn-locale", Services.locale.appLocaleAsBCP47);
+        this.#syncVantaraState(root);
+        break;
+      case "pageshow":
+      case "visibilitychange":
+        if (this.document.visibilityState == "visible") {
+          this.#syncVantaraState(root);
+          this.#sendVantaraData();
+        }
+        break;
+      case "VantaraNewTab:RequestData":
+        this.#sendVantaraData();
+        break;
+      case "VantaraNewTab:ResetBlocked":
+        this.sendAsyncMessage(event.type);
+        break;
+      case "VantaraNewTab:SetTheme":
+      case "VantaraNewTab:SetStore":
+        this.sendAsyncMessage(event.type, this.#parseDetail(event));
+        break;
+      case "VantaraNewTab:RemoveHistory":
+        this.sendQuery(event.type, this.#parseDetail(event)).then(
+          () => this.#sendVantaraData(),
+          console.error
+        );
+        break;
+    }
+  }
+
+  #parseDetail(event) {
+    try {
+      let data = JSON.parse(String(event.detail));
+      return data && typeof data == "object" ? data : {};
+    } catch (e) {
+      return {};
+    }
+  }
+
+  #syncVantaraState(root) {
+    const MODES = {
+      "firefox-compact-light@mozilla.org": "light",
+      "firefox-compact-dark@mozilla.org": "dark",
+    };
+    root.setAttribute(
+      "vn-blocked",
+      Services.prefs.getIntPref("vantara.shield.blockedTotal", 0)
+    );
+    root.setAttribute(
+      "vn-palette",
+      Services.prefs.getStringPref("vantara.theme.palette", "forge")
+    );
+    root.setAttribute(
+      "vn-mode",
+      MODES[Services.prefs.getStringPref("extensions.activeThemeID", "")] ??
+        "system"
+    );
+    let name = Services.prefs.getStringPref("vantara.search.engineName", "");
+    let url = Services.prefs.getStringPref("vantara.search.urlTemplate", "");
+    if (name && url) {
+      root.setAttribute("vn-search", JSON.stringify({ name, url }));
+    }
+  }
+
+  /**
+   * Sends the page what the browser keeps for it (VantaraNewTab:Store) and
+   * the recently visited sites (VantaraNewTab:History), in one task.
+   */
+  async #sendVantaraData() {
+    try {
+      let [store, sites] = await Promise.all([
+        this.sendQuery("VantaraNewTab:GetStore"),
+        this.sendQuery("VantaraNewTab:GetHistory"),
+      ]);
+      let win = this.contentWindow;
+      for (let [type, data] of [
+        ["VantaraNewTab:Store", store ?? {}],
+        ["VantaraNewTab:History", sites ?? []],
+      ]) {
+        win?.dispatchEvent(
+          new win.CustomEvent(type, { detail: JSON.stringify(data) })
+        );
+      }
+    } catch (e) {
+      // The page went away while the history was being read.
+    }
+  }
+
   async handleEvent(event) {
