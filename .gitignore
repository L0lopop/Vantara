# --- Сборка форка ----------------------------------------------------------
# Исходники Firefox: ~30 ГБ, скачиваются через surfer download
engine/
obj-*/
.mozbuild/
.surfer/
dist/

# --- Dev-окружение ---------------------------------------------------------
# Профиль разработчика и portable-движок: локальные, у каждого свои
.dev-profile/
.dev-runtime/

# --- Артефакты сборки ------------------------------------------------------
*.exe
*.msi
*.dmg
*.AppImage
*.tar.bz2
*.zip
!brand/**/*.ico

# --- Инструменты -----------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.venv/

# --- Система и редакторы ---------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~

# --- Снимки экрана ---------------------------------------------------------
# Автоматические снимки от tools/screenshot.ps1: их много и они тяжёлые.
# Снимок, который нужен в документации, переименовывается вручную.
docs/screenshots/firefox-*.png

# --- Локальные переопределения ---------------------------------------------
# Личные настройки поверх общих, не для репозитория
ui/prefs/user.local.js
*.local.css
