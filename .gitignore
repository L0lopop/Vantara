# --- Сборка форка ----------------------------------------------------------
# Исходники Firefox: ~30 ГБ, скачиваются через surfer download
engine/
obj-*/
.mozbuild/
.surfer/
dist/
# Переводы Firefox (mozilla-l10n/firefox-l10n), скачиваются tools/fetch-l10n.ps1
.l10n/

# --- Dev-окружение ---------------------------------------------------------
# Профили браузера и portable-движок: локальные, у каждого свои.
# В профиле лежат история, куки и настройки — в репозитории им не место.
.dev-profile/
.dev-runtime/
.native-profile/
# Профиль и копия сборки для обычной работы (tools/start.ps1)
.user-profile/
.app/

# --- Артефакты сборки ------------------------------------------------------
*.exe
*.msi
*.dmg
*.AppImage
*.tar.bz2
*.zip
!brand/**/*.ico

# --- Инструменты -----------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.venv/

# --- Система и редакторы ---------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
*~

# --- Снимки экрана ---------------------------------------------------------
# Автоматические снимки от tools/screenshot.ps1: их много и они тяжёлые.
# Снимок, который нужен в документации, переименовывается вручную.
docs/screenshots/firefox-*.png

# --- Локальные переопределения ---------------------------------------------
# Личные настройки поверх общих, не для репозитория
ui/prefs/user.local.js
*.local.css
