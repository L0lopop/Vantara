# =============================================================================
# Vantara — конфигурация сборки под Windows
# Дополняет configs/common/mozconfig.
# =============================================================================

# Firefox 156 больше не принимает ни mingw32, ни mingw64 — шаблон surfer
# на этом месте устарел. Собираем компилятором Visual Studio: это основной
# тулчейн Mozilla под Windows, официальные сборки делаются им же.
#
# Host задаётся явно вместе с target. Автоопределение запускается внутри
# msys2 и выдаёт x86_64-pc-mingw64 — по окружению оболочки, а не по тому,
# чем мы на самом деле компилируем.
ac_add_options --host=x86_64-pc-windows-msvc
ac_add_options --target=x86_64-pc-windows-msvc

# --- Отчёты о сбоях: выключены ----------------------------------------------
# Crash reporter отправляет дамп памяти процесса на сервер. В дампе может
# оказаться что угодно из того, что браузер держал в памяти: открытые
# страницы, введённый текст, содержимое форм.
#
# Отправку можно запретить настройкой, но тогда механизм всё равно остаётся
# в сборке. Мы его не собираем: Vantara не имеет сервера для отчётов и не
# собирается его заводить.
ac_add_options --disable-crashreporter

# --- Агент браузера по умолчанию: не собирается ----------------------------
# Отдельная программа Firefox, которую установщик ставит в планировщик
# Windows. Раз в день она проверяет, какой браузер выбран по умолчанию,
# отправляет отчёт Mozilla и может показать уведомление «верните Firefox».
# Даже с выключенной телеметрией задача остаётся в системе и запускается
# каждый день. Цена отключения: кнопка «сделать браузером по умолчанию»
# открывает параметры Windows, а не меняет выбор сама.
ac_add_options --disable-default-browser-agent

# --- Служба обслуживания Mozilla: не собирается --------------------------
# Установщик регистрирует её как службу Windows с правами SYSTEM, чтобы
# ставить обновления без запроса UAC. Обновления Vantara выключены, и
# служба была бы лишним процессом с наивысшими правами и именем Mozilla.
ac_add_options --disable-maintenance-service

# --- Производительность ------------------------------------------------------
ac_add_options --enable-rust-simd

# --- Установщик --------------------------------------------------------------
# Только полный установщик. Stub-установщик Firefox — маленький файл,
# который сам качает браузер: адреса и подпись в нём зашиты на
# download.mozilla.org и «Mozilla Corporation». Собранный с нашим брендом,
# он скачал бы и поставил Firefox, а заодно отправил бы Mozilla отчёт
# об установке. Своего сервера загрузки у Vantara нет.
